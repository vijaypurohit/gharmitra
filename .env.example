# Copy to .env. Everything is optional; defaults run fully offline.

# offline | live | routed
GHARMITRA_MODEL_MODE=offline

# Strong / single model. Provider: openai_compat | gemini
GHARMITRA_LLM_PROVIDER=
GHARMITRA_LLM_BASE_URL=
GHARMITRA_LLM_API_KEY=
GHARMITRA_LLM_MODEL=

# Cheap model (routed mode only)
GHARMITRA_LLM_CHEAP_PROVIDER=
GHARMITRA_LLM_CHEAP_BASE_URL=
GHARMITRA_LLM_CHEAP_API_KEY=
GHARMITRA_LLM_CHEAP_MODEL=

GHARMITRA_LLM_TIMEOUT_S=10

# Agent database. SQLite default; Postgres needs: uv sync --extra postgres
GHARMITRA_DATABASE_URL=sqlite:///data/gharmitra.db
# GHARMITRA_DATABASE_URL=postgresql://user:password@localhost:5432/gharmitra

# Mock provider world
GHARMITRA_MOCK_DB_PATH=data/mock_provider.db
GHARMITRA_SEED=42
GHARMITRA_SCENARIO=default

GHARMITRA_TRACE_DIR=traces
