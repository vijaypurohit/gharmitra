# Copy to .env. Non-secret values can also be changed in the web app's Settings page.

# ---------------------------------------------------------------------------
# Database (Postgres)
# ---------------------------------------------------------------------------
# Leave unset to use the bundled Postgres in data/pg.
# DATABASE_URL=postgresql://user:password@localhost:5432/gharmitra
# Tests create and drop their own schemas here (defaults to DATABASE_URL)
TEST_DATABASE_URL=

# ---------------------------------------------------------------------------
# Model. Pick ONE block below and uncomment it. Default: offline rules parser.
#   MODEL_ADAPTER: rules | openai | anthropic | claude_cli | your.module:YourClass
#   The "openai" adapter speaks the OpenAI chat API; MODEL_BASE_URL decides who serves it.
# ---------------------------------------------------------------------------
MODEL_ADAPTER=rules

# Gemini (free tier works; see model names and rate limits in Google AI Studio)
# MODEL_ADAPTER=openai
# MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# MODEL_NAME=<gemini flash model>
# MODEL_API_KEY=
# MODEL_MIN_INTERVAL_S=12        # 60 / requests-per-minute limit

# OpenAI
# MODEL_ADAPTER=openai
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=<openai model>
# MODEL_API_KEY=

# Anthropic (native API; its OpenAI-compatible layer ignores JSON schemas)
# MODEL_ADAPTER=anthropic
# MODEL_BASE_URL=https://api.anthropic.com
# MODEL_NAME=<claude model>
# MODEL_API_KEY=

# Claude CLI (uses your logged-in `claude` command; no API credits)
# MODEL_ADAPTER=claude_cli
# MODEL_NAME=haiku

# Ollama, local (Qwen, Llama, Gemma, ...)
# MODEL_ADAPTER=openai
# MODEL_BASE_URL=http://localhost:11434/v1
# MODEL_NAME=qwen2.5:7b

# LM Studio, local
# MODEL_ADAPTER=openai
# MODEL_BASE_URL=http://localhost:1234/v1
# MODEL_NAME=<loaded model>

# OpenRouter
# MODEL_ADAPTER=openai
# MODEL_BASE_URL=https://openrouter.ai/api/v1
# MODEL_NAME=<vendor/model>
# MODEL_API_KEY=

# Groq
# MODEL_ADAPTER=openai
# MODEL_BASE_URL=https://api.groq.com/openai/v1
# MODEL_NAME=<groq model>
# MODEL_API_KEY=

MODEL_TIMEOUT_S=30
MODEL_MIN_INTERVAL_S=0

# ---------------------------------------------------------------------------
# Traces: postgres, jsonl, or both
# ---------------------------------------------------------------------------
TRACE_SINKS=postgres,jsonl

# ---------------------------------------------------------------------------
# Locale
# ---------------------------------------------------------------------------
CITY=bengaluru
CURRENCY=INR
TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# Mock provider world
# ---------------------------------------------------------------------------
SEED=42
SCENARIO=default
